+// Global memory barriers instead of per-buffer ones: on MoltenVK the per-buffer barriers
+// did not reliably order the compute passes (frames showed data from the two previous
+// frames). They also cover transfer, since some of these sit next to buffer copies.
+static void globalBarrier(vk::CommandBuffer commandBuffer, vk::AccessFlags src, vk::AccessFlags dst) {
+    vk::MemoryBarrier barrier{src, dst};
+    commandBuffer.pipelineBarrier(vk::PipelineStageFlagBits::eComputeShader | vk::PipelineStageFlagBits::eTransfer,
+                                  vk::PipelineStageFlagBits::eComputeShader | vk::PipelineStageFlagBits::eTransfer,
+                                  {}, barrier, nullptr, nullptr);
+}
