diff --git a/src/vulkan/windowing/HeadlessWindow.cpp b/src/vulkan/windowing/HeadlessWindow.cpp
new file mode 100644
index 0000000..e5d268f
--- /dev/null
+++ b/src/vulkan/windowing/HeadlessWindow.cpp
@@ -0,0 +1,22 @@
+#include "HeadlessWindow.h"
+
+#include "../VulkanContext.h"
+
+VkSurfaceKHR HeadlessWindow::createSurface(std::shared_ptr<VulkanContext> context) {
+    auto instance = static_cast<VkInstance>(context->instance.get());
+    auto create = reinterpret_cast<PFN_vkCreateHeadlessSurfaceEXT>(
+        vkGetInstanceProcAddr(instance, "vkCreateHeadlessSurfaceEXT"));
+    if (!create) {
+        throw std::runtime_error("VK_EXT_headless_surface is not available");
+    }
+    VkHeadlessSurfaceCreateInfoEXT info{VK_STRUCTURE_TYPE_HEADLESS_SURFACE_CREATE_INFO_EXT};
+    VkSurfaceKHR surface;
+    if (create(instance, &info, nullptr, &surface) != VK_SUCCESS) {
+        throw std::runtime_error("failed to create headless surface");
+    }
+    return surface;
+}
+
+std::vector<std::string> HeadlessWindow::getRequiredInstanceExtensions() {
+    return {VK_KHR_SURFACE_EXTENSION_NAME, VK_EXT_HEADLESS_SURFACE_EXTENSION_NAME};
+}
diff --git a/src/vulkan/windowing/HeadlessWindow.h b/src/vulkan/windowing/HeadlessWindow.h
new file mode 100644
index 0000000..dd1e7d6
--- /dev/null
+++ b/src/vulkan/windowing/HeadlessWindow.h
@@ -0,0 +1,24 @@
+#ifndef HEADLESSWINDOW_H
+#define HEADLESSWINDOW_H
+
+#include "../Window.h"
+
+// no window at all, renders into a VK_EXT_headless_surface swapchain
+class HeadlessWindow : public Window {
+public:
+    HeadlessWindow(uint32_t width, uint32_t height) : width(width), height(height) {}
+
+    VkSurfaceKHR createSurface(std::shared_ptr<VulkanContext> context) override;
+
+    std::vector<std::string> getRequiredInstanceExtensions() override;
+
+    [[nodiscard]] std::pair<uint32_t, uint32_t> getFramebufferSize() const override { return {width, height}; }
+
+    bool tick() override { return true; }
+
+private:
+    uint32_t width;
+    uint32_t height;
+};
+
+#endif //HEADLESSWINDOW_H
